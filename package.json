{
  "name": "yangi-alifbo-uz",
  "private": true,
  "version": "1.0.0",
  "description": "O'zbek tili yangi takomillashtirilgan lotin alifbosi (Ö, Ğ, Ş, Ç) konvertori",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron electron/main.cjs\"",
